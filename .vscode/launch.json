{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. Server (PC side)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/server.py",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "console": "integratedTerminal"
    },
    {
      "name": "2. App (phone side)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Run BOTH (server + app)",
      "configurations": ["1. Server (PC side)", "2. App (phone side)"],
      "stopAll": true
    }
  ]
}
